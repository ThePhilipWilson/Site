.ta-foot{font-family:'VT323',monospace;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:var(--olive-deep);margin:20px 0 0}
@media(max-width:640px){.takeaway{padding:48px 24px}.ta-prompt{font-size:15px}}

/* back link as a pinned rotated sticker (top-left of the view), not a top bar */
.sa-back{position:fixed;top:60px;left:18px;z-index:95;transform:rotate(-3deg)}

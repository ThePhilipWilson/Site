.ta-actions{display:flex;align-items:center;gap:10px;padding:14px 18px 0}
.ta-actions button{font-family:'VT323',monospace;font-size:15px;text-transform:uppercase;letter-spacing:.06em;background:var(--mustard);color:var(--olive-darker);border:2px solid var(--olive-darker);padding:6px 13px;cursor:pointer;box-shadow:3px 3px 0 var(--peach-deep)}
.ta-actions button:active{transform:translate(3px,3px);box-shadow:none}
.ta-actions #ta-state{font-family:'VT323',monospace;font-size:14px;color:var(--mint-deep);text-transform:uppercase;letter-spacing:.06em}

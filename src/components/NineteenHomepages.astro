<style is:global>
/* Styles ship only on this page; tokens / grain / nav / footer come from global.css. */
/* pagify the bookends: mandatory snap with three targets, the title and the
   outro are full pages; the middle (prose + bin) is one tall snap section you
   scroll through freely, so it only snaps decisively at the two boundaries. */
html:has(.nh-root), body:has(.nh-root){scroll-snap-type:y mandatory}
.nh-root{background:var(--cream)}

/* pinned back sticker (shared look with the self-auditing piece) */
.nh-back{position:fixed;top:60px;left:18px;z-index:95;transform:rotate(-3deg)}
.nh-back a,.nh-back a:visited{display:inline-block;background:var(--cream);border:2px solid var(--olive-darker);box-shadow:3px 3px 0 var(--olive-darker);padding:7px 13px;font-family:'VT323',monospace;font-size:14px;color:var(--peach-deep);text-decoration:none;letter-spacing:.06em;text-transform:uppercase;transition:transform .15s,box-shadow .15s}
.nh-back a:hover{transform:translate(-1px,-1px);box-shadow:5px 5px 0 var(--olive-darker);color:var(--olive-darker)}
@media(max-width:1040px){.nh-back{top:50px;bottom:auto;left:12px}
  /* clear the pinned back sticker so it doesn't cover the first line of prose */
  .nh-body > .col:first-child{padding-top:88px}}

/* HERO (peach, to distinguish from the mint hero of the other piece) */
.nh-hero{background:var(--peach);padding:66px 28px 58px;text-align:center;position:relative;overflow:hidden;min-height:100vh;display:flex;flex-direction:column;justify-content:center;scroll-snap-align:start}
.nh-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:54px;background:var(--olive-darker);clip-path:polygon(0 100%,15% 30%,32% 80%,48% 20%,64% 70%,80% 25%,100% 60%,100% 100%)}
.nh-hero .k{font-family:'VT323',monospace;font-size:15px;letter-spacing:.16em;color:var(--peach-deep);text-transform:uppercase;margin-bottom:14px}
.nh-hero h1{font-family:'Bungee',sans-serif;font-size:clamp(34px,6.5vw,80px);line-height:.92;margin:0 auto 18px;max-width:18ch;text-transform:uppercase;color:var(--olive-darker);letter-spacing:-.02em;word-break:keep-all;hyphens:none}
.nh-hero h1 .big{display:inline-block;color:var(--mint);text-shadow:5px 5px 0 var(--olive-darker);transform:rotate(-3deg)}
.nh-hero .sub{font-family:Caveat,cursive;font-weight:700;font-size:26px;max-width:34ch;margin:0 auto;color:var(--olive-darker);line-height:1.2}

/* BODY prose (one tall snap section: read freely, snaps at the bookends) */
.nh-body{padding:8px 0;scroll-snap-align:start}
.nh-body .col{max-width:var(--read-max);margin:0 auto;padding:48px 24px}
.nh-body .col p{font-family:'Space Grotesk',sans-serif;font-size:18px;line-height:1.7;color:var(--olive-darker);margin:0 0 22px}
.nh-body .col .lead{font-size:21px;line-height:1.55}
.nh-body .col em{font-family:Caveat,cursive;font-style:normal;font-weight:700;color:var(--peach-deep);font-size:1.15em;line-height:1}

/* OUTRO interlude (mint) */
.nh-outro{background:var(--mint);color:var(--olive-darker);padding:80px 8vw;min-height:100vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:22px;position:relative;overflow:hidden;scroll-snap-align:start}
.nh-outro h2{align-self:flex-start;background:var(--cream);border:3px solid var(--olive-darker);box-shadow:8px 8px 0 var(--olive-darker);padding:14px 24px;font-family:'Bungee',sans-serif;font-size:clamp(28px,5.5vw,56px);text-transform:uppercase;color:var(--olive-darker);letter-spacing:-.01em;margin:0;transform:rotate(-1deg)}
.nh-outro p{max-width:52ch;margin:0;font-size:19px;line-height:1.55;color:var(--olive-darker)}
.nh-outro .tail{align-self:flex-start;background:var(--cream);border:3px solid var(--olive-darker);box-shadow:6px 6px 0 var(--olive-darker);padding:10px 18px;font-family:Caveat,cursive;font-weight:700;font-size:25px;color:var(--peach-deep);margin:0;line-height:1.2;transform:rotate(-1.4deg)}
</style>

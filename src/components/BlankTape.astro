---
import Cassette from './Cassette.astro';
// Empty-state for the writing section: a single unrecorded cassette,
// rendered inside the same deck-stack frame as the populated pile.
---
<div class="deck-stack" data-empty="true" aria-label="No tapes yet">
  <Cassette
    index={0}
    number="00"
    side="A"
    minutes={0}
    date="UNRECORDED"
    title="Blank tape · ready to record"
    tape="NORMAL"
    blank={true}
  />
</div>

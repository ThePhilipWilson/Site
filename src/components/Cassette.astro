---
interface Props {
  index: number;
  number: string;
  side: 'A' | 'B';
  minutes: number;
  date: string;
  title: string;
  tape: 'NORMAL' | 'CHROME' | 'METAL';
  href?: string;
  blank?: boolean;
}
const { index, number, side, minutes, date, title, tape, href, blank = false } = Astro.props;

const CASINGS = ['dark', 'cream', 'mint', 'peach', 'blue', 'mustard'] as const;
const STRIPES = ['rainbow', 'solid', 'alt'] as const;
const casing = blank ? 'dark' : CASINGS[index % CASINGS.length];
const stripe = blank ? 'blank' : STRIPES[index % STRIPES.length];

const TYPE_LABEL = {
  NORMAL: 'Type I · Normal',
  CHROME: 'Type II · Chrome',
  METAL:  'Type IV · Metal',
} as const;
const typeLabel = TYPE_LABEL[tape];

const Tag: 'a' | 'div' = href ? 'a' : 'div';
---
<Tag
  class="cassette"
  data-casing={casing}
  data-stripe={stripe}
  data-idx={index}
  {...(blank ? { 'data-blank': 'true' } : {})}
  href={href}
>
  <span class="screw tl"></span><span class="screw tr"></span>
  <span class="screw bl"></span><span class="screw br"></span>

  <div class="label">
    <div class="label-top">
      <span class="side-tab"><span class="word">side</span><span class="letter">{side}</span></span>
      <h3 class="title">{title}</h3>
      <span class="length-num">{minutes || '—'}</span>
    </div>
    <div class="stripe-band"><span></span><span></span><span></span><span></span></div>
    <div class="reels-row">
      <svg class="reel"><use href="#reel"/></svg>
      <div class="tape-window"></div>
      <svg class="reel"><use href="#reel"/></svg>
    </div>
    <div class="label-bottom">
      <div class="index-line"></div>
      <div class="brand-row">
        <span class="brand">P.A.W. Sounds</span>
        <span>★ {date} · No. {number} ★</span>
        <span class="type">{typeLabel}</span>
      </div>
    </div>
  </div>

  <div class="mechanism">
    <span class="screw cb"></span>
    <div class="drive-hole"></div>
    <div class="guide"></div>
    <div class="felt"></div>
    <div class="guide"></div>
    <div class="drive-hole"></div>
  </div>
</Tag>

---
import { displayMinutes, type Minutes } from '../lib/minutes';

interface Props {
  index: number;
  number: string;
  side: 'A' | 'B';
  minutes: Minutes;
  date: string;
  title: string;
  tape: 'NORMAL' | 'CHROME' | 'METAL';
  excerpt?: string;
  href?: string;
  blank?: boolean;
}
const { index, number, side, minutes, date, title, tape, excerpt, href, blank = false } = Astro.props;
const minutesLabel = displayMinutes(minutes);

// Casing colour + paper-graphic style, assigned by a stable hash of the piece so
// each tape keeps its identity regardless of publish order (not tied to `index`).
const SHELLS = ['#575756', '#9F5F33', '#4E8F74', '#6E9CA6', '#B0862B', '#5B564A'] as const;
const STYLES = ['rainbow', 'header', 'twotone', 'detail'] as const;
function hash(s: string) { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return Math.abs(h); }
function darken(hex: string, f = 0.5) {
  const n = parseInt(hex.slice(1), 16);
  return '#' + [16, 8, 0].map((s) => Math.round(((n >> s) & 255) * f).toString(16).padStart(2, '0')).join('');
}
const h = hash(title + number);
const shell = blank ? '#3f3b33' : SHELLS[h % SHELLS.length];
const style = blank ? 'blank' : STYLES[(h >> 5) % STYLES.length];
const shadow = darken(shell);

const TYPE_LABEL = { NORMAL: 'Type I', CHROME: 'Type II', METAL: 'Type IV' } as const;
const typeLabel = TYPE_LABEL[tape];

const Tag: 'a' | 'div' = href ? 'a' : 'div';
---
<Tag
  class="cassette"
  data-style={style}
  data-idx={index}
  draggable="false"
  style={`--cas-shell:${shell};--cas-shadow:${shadow}`}
  {...(blank ? { 'data-blank': 'true' } : {})}
  href={href}
>
  <svg class="cas-art" viewBox="0 0 469.7333 303.01333" preserveAspectRatio="none" aria-hidden="true"><use href="#cas-art" /></svg>

  <div class="cas-gfx">
    {style === 'rainbow' && <span class="rb"></span>}
    {style === 'header' && <><span class="hdr-bar"></span><span class="hdr-side"></span></>}
    {style === 'twotone' && <span class="tt-bar"></span>}
    {style === 'detail' && <>
      <span class="tg-side">{side}</span>
      <span class="tg-arrow"></span>
      <span class="tg-type">{typeLabel} · Normal</span>
      <span class="idx">INDEX</span>
    </>}
  </div>

  <div class="cas-title">{title}</div>
  {style !== 'detail' && <div class="cas-side">{side}</div>}
  <div class="cas-len">{minutesLabel || '—'}</div>
  <div class="cas-band">
    {excerpt && !blank
      ? <span class="cas-tracks">{excerpt}</span>
      : <span class="cas-tracks cas-tracks-blank" aria-hidden="true"></span>}
    <span class="cas-brand">
      <b>P.A.W. Sounds</b>
      <span>★ {date} · No. {number} ★</span>
      <span class="cas-type">{typeLabel}</span>
    </span>
  </div>
</Tag>

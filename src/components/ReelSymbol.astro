---
// Inline SVG <symbol> for the cassette tape reel. Reference once per page; <use> in cassettes.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="reel" viewBox="0 0 50 50">
      <circle cx="25" cy="25" r="22" fill="#F4EDDF" stroke="#2A2722" stroke-width="2"/>
      <g stroke="#2A2722" stroke-width="1.5" stroke-linecap="round">
        <line x1="25" y1="6" x2="25" y2="13"/>
        <line x1="44" y1="25" x2="37" y2="25"/>
        <line x1="25" y1="44" x2="25" y2="37"/>
        <line x1="6" y1="25" x2="13" y2="25"/>
        <line x1="11.5" y1="11.5" x2="16.5" y2="16.5"/>
        <line x1="38.5" y1="11.5" x2="33.5" y2="16.5"/>
        <line x1="11.5" y1="38.5" x2="16.5" y2="33.5"/>
        <line x1="38.5" y1="38.5" x2="33.5" y2="33.5"/>
      </g>
      <circle cx="25" cy="25" r="7" fill="#2A2722"/>
      <g fill="#F4EDDF">
        <rect x="22" y="20" width="6" height="1.5"/>
        <rect x="22" y="28.5" width="6" height="1.5"/>
        <rect x="20" y="22" width="1.5" height="6"/>
        <rect x="28.5" y="22" width="1.5" height="6"/>
      </g>
      <circle cx="25" cy="25" r="2" fill="#F4EDDF"/>
    </symbol>
  </defs>
</svg>

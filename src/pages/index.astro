---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import ReelSymbol from '../components/ReelSymbol.astro';
import Cabinet from '../components/Cabinet.astro';
import LabCard from '../components/LabCard.astro';
import NoSignal from '../components/NoSignal.astro';
import Cassette from '../components/Cassette.astro';
import BlankTape from '../components/BlankTape.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site.ts';

// Collections (filter drafts, sort newest first)
const lab = (await getCollection('lab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const monthShort = (d: Date) =>
  d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }).toUpperCase();
const yearOf = (d: Date) => d.getFullYear();
// Pad the lab grid up to complete rows (min 2 rows) with dead-channel filler
// tiles so the CRT fills its full-height section instead of letterboxing.
const labTileTarget = Math.max(6, Math.ceil(lab.length / 3) * 3);
const labFillers = Math.max(0, labTileTarget - lab.length);
---
<Layout>
  <ReelSymbol />

  <!-- COVER -->
  <header class="cover">
    <div class="wrap">
      <div class="meta-strip">
        <span>VOL.&nbsp;{site.issue.volume.toString().padStart(2, '0')} — ISSUE&nbsp;{String(site.issue.number).padStart(2, '0')}</span>
        <span>{site.issue.season}</span>
        <span>UK · £FREE</span>
      </div>
      <div>
        <h1>
          <span class="p">PHILIP</span> <span class="o">WILSON</span>
        </h1>
        <p class="sub">{site.tagline}</p>
        <a class="stamp" href={site.comingSoon ? `mailto:${site.email}` : '#lab'}>
          <span class="blink">▶</span> {site.comingSoon ? 'Say hello' : 'Press start  →  enter the lab'}
        </a>
      </div>
      <div class="photo-stack">
        <div class="polaroid p1">
          <div class="frame"><Logo width="80%" /></div>
          <div class="caption">The workshop</div>
        </div>
        <div class="polaroid p2">
          <div class="frame"></div>
          <div class="caption">{site.comingSoon ? 'Tuning in' : 'A procedural city'}</div>
        </div>
        <div class="polaroid p3">
          <div class="frame"><Logo width="60%" /></div>
          <div class="caption">Est. 2017</div>
        </div>
        {site.comingSoon && (
          <div class="coming-soon-stamp" aria-label="Coming soon">
            <span class="l1">Coming</span>
            <span class="l2">Soon</span>
            <span class="l3">★ first issue tuning in ★</span>
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- LAB -->
  <section class="spread lab" id="lab">
    <div class="wrap">
      {site.comingSoon && (
        <div class="demo-stamp" aria-label="Demo cabinet notice">
          <span class="l1">Demo</span>
          <span class="l2">Cabinet</span>
          <span class="l3">★ more titles inbound ★</span>
        </div>
      )}
      <div class="head">
        <div class="head-id">
          <span class="kicker">// SECTION 01 — THE LAB<span class="cur"></span></span>
          <span class="num">01</span>
        </div>
        <h2>The Lab</h2>
        <p class="note">
          {lab.length > 0
            ? `↳ ${lab.length} ${lab.length === 1 ? 'title' : 'titles'} in current rotation. All browser-playable.`
            : '↳ No transmissions yet. First cartridge incoming.'}
        </p>
      </div>

      <Cabinet
        marqueeLeft={lab.length > 0
          ? `★ NOW PLAYING — ${lab.length} ${lab.length === 1 ? 'TITLE' : 'TITLES'}`
          : '★ NO INPUT — STAND BY'}
        marqueeRight={lab.length > 0 ? 'INSERT COIN' : 'NO SIGNAL'}
        prompt={lab.length > 0 ? 'ls -lh ~/lab' : 'sleep ∞'}
        footCenter={lab.length > 0 ? '★ pull-out centrefold ★' : '★ first transmission incoming ★'}
        footRight={site.issue.version}
      >
        {lab.length === 0 ? (
          <NoSignal />
        ) : (
          <div class="lab-grid">
            {lab.map((entry, i) => (
              <LabCard
                index={i + 1}
                number={String(i + 1).padStart(2, '0')}
                year={yearOf(entry.data.date)}
                title={entry.data.title}
                description={entry.data.description}
                type={entry.data.type}
                stars={entry.data.stars}
                href={entry.data.demo ?? `/lab/${entry.id}`}
              />
            ))}
            {Array.from({ length: labFillers }).map((_, i) => (
              <div class="lab-card filler" aria-hidden="true">
                <div class="bars">
                  <span></span><span></span><span></span><span></span>
                  <span></span><span></span><span></span><span></span>
                </div>
                <span class="ch">CH {String(lab.length + i + 1).padStart(2, '0')} · no signal</span>
              </div>
            ))}
          </div>
        )}
      </Cabinet>
    </div>
  </section>

  <!-- WRITING -->
  <section class="spread writing" id="writing">
    <div class="wrap">
      {site.comingSoon && (
        <div class="demo-stamp" aria-label="Demo tapes notice">
          <span class="l1">Demo</span>
          <span class="l2">Tapes</span>
          <span class="l3">★ more content inbound ★</span>
        </div>
      )}
      <div class="head">
        <div class="head-id">
          <span class="kicker">// SECTION 02 — WRITING<span class="cur"></span></span>
          <span class="num">02</span>
        </div>
        <h2>Writing</h2>
        <p class="note">
          {writing.length > 0
            ? '↳ Post-mortems, working theories, lightly opinionated.'
            : '↳ Blank tape in the deck. First recording soon.'}
        </p>
      </div>

      {writing.length === 0 ? (
        <BlankTape />
      ) : (
        <>
          {writing.length > 1 && (
            <div class="deck-controls" role="group" aria-label="Tape deck controls">
              <button class="deck-btn rew" id="rew" type="button" aria-label="Previous tape">
                <span class="glyph">|◀◀</span><span>Rew</span>
              </button>
              <span class="counter">
                <span>Track </span><span class="now" id="counter-now">01</span>
                <span class="total"> / {String(writing.length).padStart(2, '0')}</span>
              </span>
              <button class="deck-btn ff" id="ff" type="button" aria-label="Next tape">
                <span>FF</span><span class="glyph">▶▶|</span>
              </button>
            </div>
          )}
          <div class="deck-stack" id="stack" tabindex="0" aria-label="Cassette pile">
            {writing.map((entry, i) => (
              <Cassette
                index={i}
                number={String(i + 1).padStart(2, '0')}
                side={entry.data.side}
                minutes={entry.data.minutes}
                date={monthShort(entry.data.date)}
                title={entry.data.title}
                tape={entry.data.tape}
                excerpt={entry.data.excerpt}
                href={`/writing/${entry.id}`}
              />
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- ABOUT -->
  <section class="spread about" id="about">
    <div class="wrap">
      <div class="head">
        <div class="head-id">
          <span class="kicker">// SECTION 03 — ABOUT<span class="cur"></span></span>
          <span class="num">03</span>
        </div>
        <h2>About</h2>
        <p class="note">↳ The person behind it.</p>
      </div>
      <div class="about-grid">
        <div class="blurb">
          {site.bio.map((p) => <p set:html={p} />)}
        </div>
        <div class="contact-card">
          <h3>↳ get in touch</h3>
          {site.links.map((l) => (
            <div class="row">
              <span class="k">{l.key}</span>
              <span class="v"><a href={l.href}>{l.label}</a></span>
            </div>
          ))}
          {site.status && (
            <div class="row">
              <span class="k">STATUS</span>
              <span class="v" style="color:var(--peach-deep)">● {site.status.label}</span>
            </div>
          )}
        </div>
      </div>
    </div>
    <Footer />
  </section>
</Layout>

<script>
  // Cassette pile: shuffle / drag / keyboard. Mounts only when the deck is
  // present (writing has 2+ entries).
  const stack = document.getElementById('stack');
  const counterNow = document.getElementById('counter-now');
  const rew = document.getElementById('rew');
  const ff  = document.getElementById('ff');
  if (stack && counterNow && rew && ff) {
    const tapes = [...stack.querySelectorAll<HTMLElement>('.cassette')];
    const VISIBLE = 8;
    let activeIdx = 0;

    // Front-loaded horizontal fan: pos 0 is the centred front tape; subsequent
    // poses trail off to the right with progressively smaller X steps and
    // irregular Y / rotation so the pile looks hand-thrown rather than neat.
    const POSE: [number, number, number][] = [
      [   0,    0,    0   ],
      [ 270,  -14,  -1.8  ],
      [ 360,   10,   2.4  ],
      [ 425,  -32,   0.8  ],
      [ 475,    6,  -3.4  ],
      [ 515,  -48,   1.6  ],
      [ 545,  -22,  -2.6  ],
      [ 570,  -68,   3.2  ],
    ];

    function update() {
      tapes.forEach((tape, i) => {
        const pos = (i - activeIdx + tapes.length) % tapes.length;
        const visible = pos < VISIBLE;
        const idx = Math.min(pos, VISIBLE - 1);
        const [x, y, r] = POSE[idx];
        tape.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) rotate(${r}deg)`;
        tape.style.transformOrigin = 'left center';
        tape.style.opacity = visible ? '1' : '0';
        tape.style.pointerEvents = visible ? 'auto' : 'none';
        tape.style.zIndex = String(visible ? (100 - pos) : 0);
        tape.classList.toggle('is-active', pos === 0);
      });
      counterNow.textContent = String(activeIdx + 1).padStart(2, '0');
    }
    const next = () => { activeIdx = (activeIdx + 1) % tapes.length; update(); };
    const prev = () => { activeIdx = (activeIdx - 1 + tapes.length) % tapes.length; update(); };

    ff.addEventListener('click', next);
    rew.addEventListener('click', prev);
    stack.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' ){ e.preventDefault(); prev(); }
      if (e.key === 'ArrowRight'){ e.preventDefault(); next(); }
    });

    // Drag the front tape sideways; past the threshold it triggers the swap.
    // Drag LEFT → next (tape sweeps off left). Drag RIGHT → previous.
    const DRAG_THRESHOLD = 80;
    let drag: { startX: number; dx: number; tape: HTMLElement } | null = null;
    let lastDragDx = 0;
    const frontTape = () => tapes[activeIdx];

    // Kill the browser's native link-drag (ghost + URL) so it doesn't fight the swipe.
    stack.addEventListener('dragstart', (e) => e.preventDefault());

    stack.addEventListener('pointerdown', (e) => {
      const tape = (e.target as HTMLElement | null)?.closest<HTMLElement>('.cassette');
      if (!tape || tape !== frontTape()) return;
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      drag = { startX: e.clientX, dx: 0, tape };
      lastDragDx = 0;
      tape.setPointerCapture(e.pointerId);
      tape.classList.add('is-dragging');
    });
    stack.addEventListener('pointermove', (e) => {
      if (!drag) return;
      drag.dx = e.clientX - drag.startX;
      const rot = Math.max(-6, Math.min(6, drag.dx * 0.04));
      drag.tape.style.transform = `translate(calc(-50% + ${drag.dx}px), -50%) rotate(${rot}deg)`;
    });
    const release = (e: PointerEvent) => {
      if (!drag) return;
      const { dx, tape } = drag;
      tape.classList.remove('is-dragging');
      try { tape.releasePointerCapture(e.pointerId); } catch {}
      drag = null;
      lastDragDx = dx;
      if (dx < -DRAG_THRESHOLD) { next(); return; }
      if (dx >  DRAG_THRESHOLD) { prev(); return; }
      update();
    };
    stack.addEventListener('pointerup',     release);
    stack.addEventListener('pointercancel', release);

    // Front tape: real navigation unless the click follows a drag.
    // Other tapes: clicking brings them forward instead of navigating.
    tapes.forEach((t, i) => t.addEventListener('click', (e) => {
      const wasDrag = Math.abs(lastDragDx) > 4;
      lastDragDx = 0;
      if (wasDrag) { e.preventDefault(); return; }
      if (i === activeIdx) return; // let the link navigate
      e.preventDefault();
      activeIdx = i;
      update();
    }));

    update();
  }
</script>

---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site.ts';

const { now } = site;
const strip = (s: string) => s.replace(/<[^>]*>/g, '').replace(/&amp;/g, '&');

// Fully data-driven: every quest's content + metadata lives on its track in
// site.ts. This page just flattens the sides into a numbered, selectable list.
let gi = 0;
const groups = now.sides.map((s) => ({
  side: s.side,
  label: s.label,
  slots: s.tracks.map((t) => ({
    i: gi++,
    title: strip(t.title),
    progress: t.progress,
    region: t.region,
    status: t.status,
    locked: t.locked,
    note: t.locked
      ? 'CLASSIFIED · this quest is sealed under NDA. Intel drops when it ships.'
      : strip(t.note),
  })),
}));
const total = gi;
---
<Layout
  title="Now · Philip Wilson"
  description="What Philip Wilson is currently building, playing, and reading. A quest log of right now."
>
  <div class="now-page" data-sel="0">
    <a class="back" href="/">← back to the cover</a>

    <div class="now-inner">
      <div class="screen">
        <header class="ss-head">
          <span class="k">// NOW · QUEST LOG<span class="cur"></span></span>
          <h1>Quest Log</h1>
          <p class="sub">↑ ↓ to browse · {now.intro}</p>
          <span class="stamp">LAST LOGGED · {now.updated} · {String(total).padStart(2, '0')} QUESTS</span>
        </header>

        {groups.map((g) => (
          <section class="qgroup">
            <div class="qbar"><span class="qmark">▸</span> {g.label} <span class="qside">SIDE {g.side}</span></div>
            <ol class="slots">
              {g.slots.map((s) => (
                <li class={`slot side-${g.side}${s.locked ? ' locked' : ''}`} data-i={s.i} tabindex="0" role="button" aria-label={s.title}>
                  <span class="thumb"><span class="no">{String(s.i + 1).padStart(2, '0')}</span></span>
                  <div class="body">
                    <span class="title">{s.locked ? '▓▓▓▓▓▓ ▓▓▓▓' : s.title}</span>
                    <div class="meta"><span>{s.progress}</span><span>{s.region}</span><span class="status">{s.status}</span></div>
                    <p class="desc">{s.note}</p>
                  </div>
                  <span class="go">▸ RESUME</span>
                </li>
              ))}
            </ol>
          </section>
        ))}

        <p class="foot-note">
          A <a href="https://nownownow.com/about">now page</a>, kept as a quest log.
          Last updated {now.updated}.
        </p>
      </div>
    </div>

    <Footer />
  </div>

  <style>
    .now-page{position:relative;background:var(--blue);min-height:100vh;color:var(--olive-darker)}
    .now-inner{padding:48px 20px 56px}
    .back{position:fixed;top:60px;left:18px;z-index:95;transform:rotate(-3deg);display:inline-block;background:var(--cream);border:2px solid var(--olive-darker);box-shadow:3px 3px 0 var(--peach-deep);padding:7px 13px;font-family:'VT323',monospace;font-size:14px;color:var(--peach-deep);text-decoration:none;letter-spacing:.06em;text-transform:uppercase;transition:transform .15s,box-shadow .15s}
    .back:hover{transform:translate(-1px,-1px) rotate(-3deg);box-shadow:5px 5px 0 var(--peach-deep)}
    @media (max-width:1040px){.back{top:50px;left:12px}}

    /* the quest log lives on a contained dark "screen", on the bright page */
    .screen{position:relative;max-width:var(--read-max);margin:0 auto;background:var(--olive-darker);border:3px solid var(--olive-darker);box-shadow:11px 11px 0 var(--peach-deep);border-radius:12px;padding:28px 26px 14px;overflow:hidden}
    .screen::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:1;background:repeating-linear-gradient(180deg,rgba(0,0,0,0) 0 3px,rgba(0,0,0,.12) 3px 4px);border-radius:12px}
    .screen > *{position:relative;z-index:2}
    .ss-head{margin:8px 0 26px}
    .k{font-family:'VT323',monospace;font-size:15px;letter-spacing:.14em;color:var(--peach);text-transform:uppercase}
    .k .cur{display:inline-block;width:6px;height:12px;background:currentColor;vertical-align:-1px;animation:blink 1s steps(2) infinite;margin-left:4px}
    .ss-head h1{font-family:'Bungee',sans-serif;font-size:clamp(36px,5.5vw,56px);margin:10px 0 10px;text-transform:uppercase;color:var(--mustard);letter-spacing:-.01em;line-height:1}
    .ss-head .sub{font-family:Caveat,cursive;font-weight:700;font-size:23px;line-height:1.25;color:var(--blue);margin:0 0 12px;max-width:54ch;transform:rotate(-.5deg)}
    .ss-head .stamp{display:inline-block;font-family:'VT323',monospace;font-size:13px;letter-spacing:.12em;color:var(--olive-darker);background:var(--mustard);padding:3px 10px;text-transform:uppercase;transform:rotate(-1deg)}

    .qgroup{margin-bottom:24px}
    .qbar{display:flex;align-items:center;gap:10px;font-family:'VT323',monospace;font-size:16px;letter-spacing:.16em;color:var(--mustard);text-transform:uppercase;margin-bottom:12px;border-bottom:2px solid var(--olive);padding-bottom:6px}
    .qbar .qmark{color:var(--peach);animation:blink 1.2s steps(2) infinite}
    .qbar .qside{margin-left:auto;color:var(--olive);font-size:13px;letter-spacing:.1em}

    .slots{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
    .slot{display:grid;grid-template-columns:70px 1fr auto;gap:18px;align-items:center;background:var(--olive-deep);border:2px solid var(--olive);box-shadow:5px 5px 0 rgba(0,0,0,.4);padding:15px;cursor:pointer;transition:transform .12s,box-shadow .12s,border-color .12s}
    .slot .thumb{width:70px;height:70px;background:var(--olive-darker);border:2px solid var(--mustard);display:flex;align-items:center;justify-content:center}
    .slot.side-B .thumb{border-color:var(--mint)}
    .slot .thumb .no{font-family:'Bungee',sans-serif;font-size:24px;color:var(--mustard)}
    .slot.side-B .thumb .no{color:var(--mint)}
    .slot .title{display:block;font-family:'Bungee',sans-serif;font-size:19px;text-transform:uppercase;color:var(--cream);letter-spacing:-.01em;margin-bottom:8px}
    .slot .meta{display:flex;flex-wrap:wrap;gap:7px;font-family:'VT323',monospace;font-size:14px;letter-spacing:.06em;text-transform:uppercase}
    .slot .meta span{background:var(--olive-darker);border:1px solid var(--olive);color:var(--blue);padding:2px 9px}
    .slot .meta .status{color:var(--mustard);border-color:var(--mustard)}
    .slot .desc{display:none;font-family:'Space Grotesk',sans-serif;font-size:16px;line-height:1.5;color:var(--cream);margin:12px 0 0}
    .slot .go{font-family:'VT323',monospace;font-size:16px;letter-spacing:.08em;color:var(--peach);opacity:0;white-space:nowrap}
    .slot.locked .thumb{border-color:var(--ink)}
    .slot.locked .thumb .no{color:var(--ink)}

    .slot.sel{border-color:var(--mustard);box-shadow:8px 8px 0 var(--peach-deep);transform:translate(-2px,-2px)}
    .slot.sel .desc{display:block}
    .slot.sel .go{opacity:1;animation:blink 1.1s steps(2) infinite}
    .slot.sel.locked{border-color:var(--ink)}
    .slot.sel.locked .go{color:var(--ink)}
    .slot:hover{border-color:var(--mustard)}
    .slot.side-B:hover{border-color:var(--mint)}
    .slot:focus-visible{outline:2px solid var(--peach);outline-offset:2px}

    .foot-note{font-family:'VT323',monospace;font-size:15px;letter-spacing:.04em;text-transform:uppercase;color:var(--olive);margin:30px 0 0;padding-bottom:40px}
    .foot-note a{color:var(--peach);text-decoration:none;border-bottom:1.5px solid var(--peach)}
    .foot-note a:hover{color:var(--mustard);border-color:var(--mustard)}

    @media (prefers-reduced-motion:reduce){
      .k .cur,.qbar .qmark,.slot.sel .go{animation:none}
    }
    @media (max-width:540px){
      .slot{grid-template-columns:52px 1fr;gap:12px}
      .slot .thumb{width:52px;height:52px}
      .slot .go{display:none}
    }
  </style>

  <script>
    const slots = Array.from(document.querySelectorAll('.slot'));
    let sel = 0;
    function select(n, scroll = true) {
      sel = (n + slots.length) % slots.length;
      slots.forEach((s, i) => s.classList.toggle('sel', i === sel));
      if (scroll) slots[sel].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
    slots.forEach((s, i) => {
      s.addEventListener('click', () => select(i, false));
      s.addEventListener('focus', () => select(i, false));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); select(sel + 1); }
      if (e.key === 'ArrowUp') { e.preventDefault(); select(sel - 1); }
    });
    select(0, false);
  </script>
</Layout>

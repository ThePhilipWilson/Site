---
import Logo from '../components/Logo.astro';
import { site } from '../lib/site.ts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = site.name,
  description = site.tagline,
} = Astro.props;
const issueLabel = `Issue ${String(site.issue.number).padStart(2, '0')} · ${site.issue.season.split(' ')[1] ?? ''}`.trim();
// The section links are same-page anchors that only exist on the home page;
// hide them on sub-pages (articles), where they'd be dead links.
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Bungee&family=Caveat:wght@500;700&family=VT323&family=Space+Grotesk:wght@400;500;700&display=swap"
  />
  <title>{title}</title>
</head>
<body>

  <nav class="site-nav">
    <a class="mark" href="/" aria-label={site.name}>
      <Logo width={22} height={22} />
      <span>{site.name}</span>
    </a>
    {isHome && (
      <div class="links">
        <a href="#lab">Lab</a>
        <a href="#writing">Writing</a>
        <a href="#about">About</a>
        <a href={`mailto:${site.email}`}>Hello</a>
      </div>
    )}
    <span class="badge">{issueLabel}</span>
  </nav>

  <slot />

</body>
</html>
